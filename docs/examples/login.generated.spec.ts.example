// ANSWER KEY — do not edit, and do not run from here.
//
// This is what `agy` produced from e2e/intents/auth/login.intent.md when this
// codelab was built. In the lab YOU generate this file yourself: run the Lab 3
// prompt from docs/prompts.md and the agent writes tests/auth/login.generated.spec.ts.
// Yours may differ slightly — that's fine, as long as it passes and uses role
// and label locators.
//
// Stuck, or offline? `make restore-generated` copies these examples into tests/.

import { expect, test } from "@playwright/test";

// source-intent: e2e/intents/auth/login.intent.md
// Generated by: agy -p "Read e2e/intents/auth/login.intent.md and create this
// spec using getByRole/getByLabel. Run it until it passes. Do not change app code."
//
// Compare with tests/auth/login.spec.ts: same journey, no CSS classes. This
// version keeps passing after `make break-ui`.
test("host can sign in and reach the wallet overview", async ({ page }) => {
  await page.goto("/");
  await page.getByRole("link", { name: /^sign in$/i }).first().click();

  await page.getByLabel("Email").fill(process.env.TEST_HOST_EMAIL ?? "host@bookmi.test");
  await page
    .getByLabel("Password", { exact: true })
    .fill(process.env.TEST_HOST_PASSWORD ?? "password");
  await page.getByRole("button", { name: /^(sign in|log in)$/i }).click();

  await expect(page.getByRole("heading", { name: "Wallet overview" })).toBeVisible();
  await expect(page.getByText("Wallet balance")).toBeVisible();
});
